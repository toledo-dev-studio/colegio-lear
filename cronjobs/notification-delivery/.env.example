# Base de datos del backend (la misma DATABASE_URL del web service)
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?sslmode=no-verify"

# Microsoft Graph (mismo App Registration que el backend; requiere Mail.Send de tipo Application)
MAIL_FROM="noreply@colegiolear.mx"
MAIL_GRAPH_TENANT_ID=""
MAIL_GRAPH_CLIENT_ID=""
MAIL_GRAPH_CLIENT_SECRET=""

# Links de los correos: empleados → portal admin, tutores → portal de alumnos
FRONTEND_URL_ADMIN="https://admin.ejemplo.com"
FRONTEND_URL_STUDENT="https://alumnos.ejemplo.com"

# Opcional: si tiene un correo, cada ejecución le envía un correo de prueba.
# Dejar vacío en operación normal (si no, llega uno diario).
CRON_TEST_EMAIL=""
