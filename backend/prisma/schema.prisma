// Prisma schema for Colegio Lear
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "auth", "logs"]
}

// ─── Academic Level ─────────────────────────────────────────────────────────────

model AcademicLevel {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true) @map("is_active")
  isDeleted       Boolean          @default(false) @map("is_deleted")
  educationLevels EducationLevel[]
  schoolSubjects  SchoolSubject[]
  academicCycles  AcademicCycle[]

  @@map("academic_levels")
  @@schema("core")
}

// ─── Education Level ────────────────────────────────────────────────────────────

model EducationLevel {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  description     String?         @db.VarChar(500)
  academicLevelId String          @map("academic_level_id") @db.Uuid
  academicLevel   AcademicLevel   @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  schoolSubjects  SchoolSubject[]
  academicCycles  AcademicCycle[]

  @@unique([name, academicLevelId])
  @@map("education_levels")
  @@schema("core")
}

// ─── School Subject ─────────────────────────────────────────────────────────────

model SchoolSubject {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @db.VarChar(150)
  description                 String?                      @db.VarChar(500)
  isActive                    Boolean                      @default(true) @map("is_active")
  isDeleted                   Boolean                      @default(false) @map("is_deleted")
  academicLevelId             String                       @map("academic_level_id") @db.Uuid
  educationLevelId            String                       @map("education_level_id") @db.Uuid
  academicLevel               AcademicLevel                @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  educationLevel              EducationLevel               @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  academicCycleSchoolSubjects AcademicCycleSchoolSubject[]

  @@unique([name, educationLevelId])
  @@map("school_subjects")
  @@schema("core")
}

// ─── Scholarship ────────────────────────────────────────────────────────────────

model Scholarship {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String  @unique @db.VarChar(100)
  description        String? @db.VarChar(500)
  discountPercentage Decimal @map("discount_percentage") @db.Decimal(5, 2)
  isActive           Boolean @default(true) @map("is_active")
  isDeleted          Boolean @default(false) @map("is_deleted")

  @@map("scholarships")
  @@schema("core")
}

// ─── Payment Concept ────────────────────────────────────────────────────────────

model PaymentConcept {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique @db.VarChar(100)
  description          String?               @db.VarChar(500)
  amount               Decimal               @map("amount") @db.Decimal(10, 2)
  allowForgiveness     Boolean               @default(false) @map("allow_remission")
  isActive             Boolean               @default(true) @map("is_active")
  isDeleted            Boolean               @default(false) @map("is_deleted")
  academicCycleWallets AcademicCycleWallet[]

  @@map("payment_concepts")
  @@schema("core")
}

// ─── View: School Subjects (read-only, enriched with level names) ───────────────

view VSchoolSubject {
  id                 String  @unique @db.Uuid
  name               String  @db.VarChar(150)
  description        String  @db.VarChar(500)
  status             Boolean
  academicLevelId    String  @map("academic_level_id") @db.Uuid
  academicLevelName  String  @map("academic_level_name") @db.VarChar(100)
  educationLevelId   String  @map("education_level_id") @db.Uuid
  educationLevelName String  @map("education_level_name") @db.VarChar(100)

  @@map("v_school_subjects")
  @@schema("core")
}

// ─── View: Academic Levels (read-only, flat projection for list queries) ────────

view VAcademicLevel {
  id          String  @unique @db.Uuid
  name        String  @db.VarChar(100)
  description String  @db.VarChar(500)
  status      Boolean

  @@map("v_academic_levels")
  @@schema("core")
}

// ─── Job Title ──────────────────────────────────────────────────────────────────

enum JobTitleType {
  teacher              @map("teacher")
  administrative_staff @map("administrative-staff")

  @@schema("core")
}

model JobTitle {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique @db.VarChar(100)
  description  String?      @db.VarChar(500)
  jobTitleType JobTitleType @map("job_title_type")
  isActive     Boolean      @default(true) @map("is_active")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  employees    Employee[]

  @@map("job_titles")
  @@schema("core")
}

// ─── Security Role ──────────────────────────────────────────────────────────────

model SecurityRole {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @unique @db.VarChar(100)
  description String?                  @db.VarChar(500)
  isActive    Boolean                  @default(true) @map("is_active")
  isDeleted   Boolean                  @default(false) @map("is_deleted")
  permissions SecurityRolePermission[]
  employees   Employee[]

  @@map("security_roles")
  @@schema("core")
}

// ─── Security Role Permission ───────────────────────────────────────────────────

model SecurityRolePermission {
  id             String       @id @default(uuid()) @db.Uuid
  securityRoleId String       @map("security_role_id") @db.Uuid
  moduleKey      String       @map("module_key") @db.VarChar(50)
  canRead        Boolean      @map("can_read")
  canWrite       Boolean      @map("can_write")
  canDelete      Boolean      @map("can_delete")
  securityRole   SecurityRole @relation(fields: [securityRoleId], references: [id], onDelete: Cascade)

  @@unique([securityRoleId, moduleKey])
  @@map("security_role_permissions")
  @@schema("core")
}

// ─── Employee ───────────────────────────────────────────────────────────────────

model Employee {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @db.VarChar(100)
  firstLastName      String       @map("first_last_name") @db.VarChar(100)
  secondLastName     String?      @map("second_last_name") @db.VarChar(100)
  phoneNumber        String       @map("phone_number") @db.VarChar(20)
  email              String       @unique @db.VarChar(150)
  username           String       @unique @db.VarChar(50)
  password           String       @db.VarChar(255)
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  image              String?      @db.VarChar(500)
  isActive           Boolean      @default(true) @map("is_active")
  isDeleted          Boolean      @default(false) @map("is_deleted")
  securityRoleId     String       @map("security_role_id") @db.Uuid
  jobTitleId         String       @map("job_title_id") @db.Uuid
  securityRole       SecurityRole @relation(fields: [securityRoleId], references: [id], onDelete: Restrict)
  jobTitle           JobTitle     @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)

  @@map("employees")
  @@schema("core")
}

// ─── Announcement ───────────────────────────────────────────────────────────────

model Announcement {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  description String?      @db.VarChar(500)
  audience    Json
  content     String       @db.Text
  publishedAt DateTime     @map("published_at")
  expiresAt   DateTime     @map("expires_at")
  status      Boolean      @default(true)
  isDeleted   Boolean      @default(false) @map("is_deleted")
  attachments Attachment[]

  @@map("announcements")
  @@schema("core")
}

// ─── Attachment ─────────────────────────────────────────────────────────────────

model Attachment {
  id              String       @id @default(uuid()) @db.Uuid
  url             String       @db.VarChar(500)
  name            String       @db.VarChar(300)
  extension       String       @db.VarChar(20)
  relatedRecordId String       @map("related_record_id") @db.Uuid
  announcement    Announcement @relation(fields: [relatedRecordId], references: [id], onDelete: Cascade)

  @@map("attachments")
  @@schema("core")
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  firstLastName  String   @map("first_last_name") @db.VarChar(100)
  secondLastName String   @map("second_last_name") @db.VarChar(100)
  dateOfBirth    DateTime @map("date_of_birth")
  curp           String   @unique @db.VarChar(18)
  enrollment     String   @unique @db.VarChar(20)
  image          String?  @db.VarChar(500)
  observations   String?  @db.VarChar(1000)
  status         Boolean  @default(true)
  email          String   @unique @db.VarChar(150)
  phoneNumber    String   @map("phone_number") @db.VarChar(20)
  address        String   @db.VarChar(300)
  state          String   @db.VarChar(100)
  municipality   String   @db.VarChar(100)
  postalCode     String   @map("postal_code") @db.VarChar(10)
  password       String   @db.VarChar(255)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  medicalInformation StudentMedicalInformation?
  guardians          StudentGuardian[]

  @@map("students")
  @@schema("core")
}

// ─── Student Medical Information ─────────────────────────────────────────────

enum BloodType {
  A_POSITIVE  @map("A+")
  A_NEGATIVE  @map("A-")
  B_POSITIVE  @map("B+")
  B_NEGATIVE  @map("B-")
  AB_POSITIVE @map("AB+")
  AB_NEGATIVE @map("AB-")
  O_POSITIVE  @map("O+")
  O_NEGATIVE  @map("O-")

  @@schema("core")
}

enum AllergySeverity {
  mild     @map("mild")
  moderate @map("moderate")
  severe   @map("severe")

  @@schema("core")
}

model StudentMedicalInformation {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @unique @map("student_id") @db.Uuid
  bloodType      BloodType        @map("blood_type")
  emergencyNotes String?          @map("emergency_notes") @db.VarChar(1000)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergies      StudentAllergy[]

  @@map("student_medical_information")
  @@schema("core")
}

// ─── Student Allergy ─────────────────────────────────────────────────────────

model StudentAllergy {
  id                   String                    @id @default(uuid()) @db.Uuid
  medicalInformationId String                    @map("medical_information_id") @db.Uuid
  name                 String                    @db.VarChar(100)
  severity             AllergySeverity
  observations         String?                   @db.VarChar(500)
  medicalInformation   StudentMedicalInformation @relation(fields: [medicalInformationId], references: [id], onDelete: Cascade)

  @@map("student_allergies")
  @@schema("core")
}

// ─── Student Guardian ─────────────────────────────────────────────────────────

enum StudentGuardianType {
  father         @map("father")
  mother         @map("mother")
  grandmother    @map("grandmother")
  grandfather    @map("grandfather")
  uncle          @map("uncle")
  aunt           @map("aunt")
  brother        @map("brother")
  sister         @map("sister")
  legal_guardian @map("legal-guardian")
  step_father    @map("step-father")
  step_mother    @map("step-mother")
  other          @map("other")

  @@schema("core")
}

model StudentGuardian {
  id                 String              @id @default(uuid()) @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  fullName           String              @map("full_name") @db.VarChar(200)
  relationship       StudentGuardianType
  phoneNumber        String              @map("phone_number") @db.VarChar(20)
  email              String              @db.VarChar(150)
  isPrincipal        Boolean             @default(false) @map("is_principal")
  emergencyContact   Boolean             @default(false) @map("emergency_contact")
  authorizedToPickUp Boolean             @default(false) @map("authorized_to_pick_up")
  observations       String?             @db.VarChar(500)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_guardians")
  @@schema("core")
}

// ─── Academic Cycle ──────────────────────────────────────────────────────────

enum AcademicPeriodType {
  annual            @map("annual")
  semester          @map("semester")
  four_month_period @map("four-month-period")
  trimester         @map("trimester")
  bimester          @map("bimester")
  monthly           @map("monthly")
  intensive         @map("intensive")
  special           @map("special")

  @@schema("core")
}

enum AcademicCycleStatus {
  upcoming  @map("upcoming")
  active    @map("active")
  completed @map("completed")
  cancelled @map("cancelled")
  archived  @map("archived")

  @@schema("core")
}

model AcademicCycle {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(100)
  code             String              @unique @db.VarChar(20)
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  type             AcademicPeriodType
  status           AcademicCycleStatus @default(upcoming)
  enrollmentOpen   Boolean             @default(false) @map("enrollment_open")
  description      String?             @db.VarChar(500)
  observations     String?             @db.VarChar(1000)
  academicLevelId  String              @map("academic_level_id") @db.Uuid
  educationLevelId String              @map("education_level_id") @db.Uuid
  academicLevel    AcademicLevel       @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  educationLevel   EducationLevel      @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  schoolSubjects AcademicCycleSchoolSubject[]
  walletItems    AcademicCycleWallet[]
  groups         AcademicCycleGroup[]

  @@map("academic_cycles")
  @@schema("core")
}

// ─── Academic Cycle School Subject ───────────────────────────────────────────

model AcademicCycleSchoolSubject {
  id              String        @id @default(uuid()) @db.Uuid
  academicCycleId String        @map("academic_cycle_id") @db.Uuid
  schoolSubjectId String        @map("school_subject_id") @db.Uuid
  observations    String?       @db.VarChar(500)
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  schoolSubject   SchoolSubject @relation(fields: [schoolSubjectId], references: [id], onDelete: Restrict)

  @@unique([academicCycleId, schoolSubjectId])
  @@map("academic_cycle_school_subjects")
  @@schema("core")
}

// ─── Academic Cycle Wallet ───────────────────────────────────────────────────

model AcademicCycleWallet {
  id               String         @id @default(uuid()) @db.Uuid
  academicCycleId  String         @map("academic_cycle_id") @db.Uuid
  paymentConceptId String         @map("payment_concept_id") @db.Uuid
  dueDate          DateTime       @map("due_date")
  amount           Decimal        @db.Decimal(10, 2)
  allowForgiveness Boolean        @default(false) @map("allow_forgiveness")
  academicCycle    AcademicCycle  @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  paymentConcept   PaymentConcept @relation(fields: [paymentConceptId], references: [id], onDelete: Restrict)

  @@map("academic_cycle_wallet")
  @@schema("core")
}

// ─── Academic Cycle Group ────────────────────────────────────────────────────

model AcademicCycleGroup {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(100)
  status          Boolean       @default(true)
  description     String?       @db.VarChar(500)
  academicCycleId String        @map("academic_cycle_id") @db.Uuid
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("academic_cycle_groups")
  @@schema("core")
}
