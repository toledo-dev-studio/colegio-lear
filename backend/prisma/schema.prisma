// Prisma schema for Colegio Lear
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "core", "logs"]
}

// ─── core schema ───

model Employee {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  employeeType String   @map("employee_type")
  isActive     Boolean  @default(true) @map("is_active")
  profileId    Int?     @map("profile_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile       Profile?       @relation(fields: [profileId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("employees")
  @@schema("core")
}

model Profile {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees  Employee[]
  privileges Privilege[]

  @@map("profiles")
  @@schema("core")
}

model Privilege {
  id                Int      @id @default(autoincrement())
  profileId         Int      @map("profile_id")
  moduleReferenceId Int      @map("module_reference_id")
  action            String
  createdAt         DateTime @default(now()) @map("created_at")

  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleReference ModuleReference @relation(fields: [moduleReferenceId], references: [id])

  @@unique([profileId, moduleReferenceId, action])
  @@map("privileges")
  @@schema("core")
}

model ModuleReference {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  privileges Privilege[]

  @@map("module_references")
  @@schema("core")
}

// ─── auth schema ───

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  employeeId Int      @map("employee_id")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("auth")
}

// ─── logs schema ───

model AuditLog {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("audit_logs")
  @@schema("logs")
}
