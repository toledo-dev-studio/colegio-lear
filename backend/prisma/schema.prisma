// Prisma schema for Colegio Lear
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "auth", "logs"]
}

// ─── Academic Level ─────────────────────────────────────────────────────────────

model AcademicLevel {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true) @map("is_active")
  isDeleted       Boolean          @default(false) @map("is_deleted")
  educationLevels EducationLevel[]
  schoolSubjects  SchoolSubject[]
  academicCycles  AcademicCycle[]

  @@map("academic_levels")
  @@schema("core")
}

// ─── Education Level ────────────────────────────────────────────────────────────

model EducationLevel {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  description     String?         @db.VarChar(500)
  academicLevelId String          @map("academic_level_id") @db.Uuid
  academicLevel   AcademicLevel   @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  schoolSubjects  SchoolSubject[]
  academicCycles  AcademicCycle[]

  @@unique([name, academicLevelId])
  @@map("education_levels")
  @@schema("core")
}

// ─── School Subject ─────────────────────────────────────────────────────────────

model SchoolSubject {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @db.VarChar(150)
  description                 String?                      @db.VarChar(500)
  isActive                    Boolean                      @default(true) @map("is_active")
  isDeleted                   Boolean                      @default(false) @map("is_deleted")
  academicLevelId             String                       @map("academic_level_id") @db.Uuid
  educationLevelId            String                       @map("education_level_id") @db.Uuid
  academicLevel               AcademicLevel                @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  educationLevel              EducationLevel               @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  academicCycleSchoolSubjects AcademicCycleSchoolSubject[]
  studentGrades               StudentGrade[]

  @@unique([name, educationLevelId])
  @@map("school_subjects")
  @@schema("core")
}

// ─── Scholarship ────────────────────────────────────────────────────────────────

model Scholarship {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @unique @db.VarChar(100)
  description              String?                   @db.VarChar(500)
  discountPercentage       Decimal                   @map("discount_percentage") @db.Decimal(5, 2)
  isActive                 Boolean                   @default(true) @map("is_active")
  isDeleted                Boolean                   @default(false) @map("is_deleted")
  academicCycleEnrollments AcademicCycleEnrollment[]

  @@map("scholarships")
  @@schema("core")
}

// ─── Payment Concept ────────────────────────────────────────────────────────────

model PaymentConcept {
  id               String  @id @default(uuid()) @db.Uuid
  name             String  @unique @db.VarChar(100)
  code             String  @unique @db.VarChar(10)
  description      String? @db.VarChar(500)
  amount           Decimal @map("amount") @db.Decimal(10, 2)
  allowForgiveness Boolean @default(false) @map("allow_remission")
  isActive         Boolean @default(true) @map("is_active")
  isDeleted        Boolean @default(false) @map("is_deleted")

  @@map("payment_concepts")
  @@schema("core")
}

// ─── View: School Subjects (read-only, enriched with level names) ───────────────

view VSchoolSubject {
  id                 String  @unique @db.Uuid
  name               String  @db.VarChar(150)
  description        String  @db.VarChar(500)
  status             Boolean
  academicLevelId    String  @map("academic_level_id") @db.Uuid
  academicLevelName  String  @map("academic_level_name") @db.VarChar(100)
  educationLevelId   String  @map("education_level_id") @db.Uuid
  educationLevelName String  @map("education_level_name") @db.VarChar(100)

  @@map("v_school_subjects")
  @@schema("core")
}

// ─── View: Academic Levels (read-only, flat projection for list queries) ────────

view VAcademicLevel {
  id          String  @unique @db.Uuid
  name        String  @db.VarChar(100)
  description String  @db.VarChar(500)
  status      Boolean

  @@map("v_academic_levels")
  @@schema("core")
}

// ─── Job Title ──────────────────────────────────────────────────────────────────

enum JobTitleType {
  teacher              @map("teacher")
  administrative_staff @map("administrative-staff")

  @@schema("core")
}

model JobTitle {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique @db.VarChar(100)
  description  String?      @db.VarChar(500)
  jobTitleType JobTitleType @map("job_title_type")
  isActive     Boolean      @default(true) @map("is_active")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  employees    Employee[]

  @@map("job_titles")
  @@schema("core")
}

// ─── Security Role ──────────────────────────────────────────────────────────────

model SecurityRole {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @unique @db.VarChar(100)
  description String?                  @db.VarChar(500)
  isActive    Boolean                  @default(true) @map("is_active")
  isDeleted   Boolean                  @default(false) @map("is_deleted")
  permissions SecurityRolePermission[]
  employees   Employee[]

  @@map("security_roles")
  @@schema("core")
}

// ─── Security Role Permission ───────────────────────────────────────────────────

model SecurityRolePermission {
  id             String       @id @default(uuid()) @db.Uuid
  securityRoleId String       @map("security_role_id") @db.Uuid
  moduleKey      String       @map("module_key") @db.VarChar(50)
  canRead        Boolean      @map("can_read")
  canWrite       Boolean      @map("can_write")
  canDelete      Boolean      @map("can_delete")
  securityRole   SecurityRole @relation(fields: [securityRoleId], references: [id], onDelete: Cascade)

  @@unique([securityRoleId, moduleKey])
  @@map("security_role_permissions")
  @@schema("core")
}

// ─── Employee ───────────────────────────────────────────────────────────────────

model Employee {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @db.VarChar(100)
  firstLastName               String                       @map("first_last_name") @db.VarChar(100)
  secondLastName              String?                      @map("second_last_name") @db.VarChar(100)
  phoneNumber                 String                       @map("phone_number") @db.VarChar(20)
  email                       String                       @unique @db.VarChar(150)
  username                    String                       @unique @db.VarChar(50)
  password                    String                       @db.VarChar(255)
  mustChangePassword          Boolean                      @default(false) @map("must_change_password")
  passwordResetCode           String?                      @map("password_reset_code") @db.VarChar(255)
  passwordResetCodeExpiresAt  DateTime?                    @map("password_reset_code_expires_at")
  avatar                      String?                      @db.VarChar(500)
  isActive                    Boolean                      @default(true) @map("is_active")
  isDeleted                   Boolean                      @default(false) @map("is_deleted")
  securityRoleId              String                       @map("security_role_id") @db.Uuid
  jobTitleId                  String                       @map("job_title_id") @db.Uuid
  securityRole                SecurityRole                 @relation(fields: [securityRoleId], references: [id], onDelete: Restrict)
  jobTitle                    JobTitle                     @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  academicCycleGroupCalendars AcademicCycleGroupCalendar[]
  notifications               Notification[]
  createdAt                   DateTime                     @default(now()) @map("created_at")

  @@map("employees")
  @@schema("core")
}

// ─── Announcement ───────────────────────────────────────────────────────────────

enum AnnouncementStatus {
  draft       @map("draft")
  in_progress @map("in-progress")
  completed   @map("completed")
  cancelled   @map("cancelled")

  @@schema("core")
}

model Announcement {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  description String?      @db.VarChar(500)
  audience    Json
  content     String       @db.Text
  publishedAt DateTime     @map("published_at")
  expiresAt   DateTime     @map("expires_at")
  status      AnnouncementStatus @default(draft)
  // True once this campaign has been set to "in-progress" for the first
  // time — the point where recipients are resolved and locked in. Never
  // reset back to false afterward, even if status later moves to
  // completed/cancelled; it exists solely to make that recipient-resolution
  // step idempotent (run exactly once) and to stop the frontend from
  // offering "draft" again once a campaign has gone out.
  alreadyPublished Boolean @default(false) @map("already_published")
  isDeleted   Boolean      @default(false) @map("is_deleted")

  // Calculated (cron-maintained) view-tracking history. Stored on the
  // announcement itself — not on a per-recipient notification row — so this
  // aggregate survives even if the underlying notification records are
  // later purged.
  recipientsCount   Int       @default(0) @map("recipients_count")
  viewedCount       Int       @default(0) @map("viewed_count")
  viewsCalculatedAt DateTime? @map("views_calculated_at")

  attachments Attachment[]

  @@map("announcements")
  @@schema("core")
}

// ─── Attachment ─────────────────────────────────────────────────────────────────

model Attachment {
  id              String       @id @default(uuid()) @db.Uuid
  url             String       @db.VarChar(500)
  name            String       @db.VarChar(300)
  extension       String       @db.VarChar(20)
  relatedRecordId String       @map("related_record_id") @db.Uuid
  announcement    Announcement @relation(fields: [relatedRecordId], references: [id], onDelete: Cascade)

  @@map("attachments")
  @@schema("core")
}

// ─── Notification ───────────────────────────────────────────────────────────
// Recipients are employees only for now — there is no student-facing app yet
// to display notifications, so an audience of "student" on an announcement
// does not generate rows here (see AnnouncementService/NotificationService).

enum NotificationType {
  info
  error
  announcement
  message

  @@schema("core")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  title           String           @db.VarChar(200)
  message         String           @db.VarChar(1000)
  type            NotificationType
  relatedRecordId String           @map("related_record_id") @db.Uuid
  read            Boolean          @default(false)
  readAt          DateTime?        @map("read_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("notifications")
  @@schema("core")
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(100)
  firstLastName      String    @map("first_last_name") @db.VarChar(100)
  secondLastName     String    @map("second_last_name") @db.VarChar(100)
  dateOfBirth        DateTime  @map("date_of_birth")
  curp               String    @unique @db.VarChar(18)
  enrollment         String    @unique @db.VarChar(20)
  avatar             String?   @db.VarChar(500)
  observations       String?   @db.VarChar(1000)
  isActive           Boolean   @default(true) @map("is_active")
  bloodType          BloodType @map("blood_type")
  medicalNotes       String?   @map("medical_notes") @db.VarChar(1000)
  email              String    @unique @db.VarChar(150)
  phoneNumber        String    @map("phone_number") @db.VarChar(20)
  address            String    @db.VarChar(300)
  state              String    @db.VarChar(100)
  municipality       String    @db.VarChar(100)
  postalCode         String    @map("postal_code") @db.VarChar(10)
  password           String    @db.VarChar(255)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  guardians                StudentGuardian[]
  allergies                StudentAllergy[]
  academicCycleEnrollments AcademicCycleEnrollment[]
  walletItems              StudentWalletItem[]

  @@map("students")
  @@schema("core")
}

// ─── Student Medical Info (blood type / allergies) ───────────────────────────

enum BloodType {
  A_POSITIVE  @map("A+")
  A_NEGATIVE  @map("A-")
  B_POSITIVE  @map("B+")
  B_NEGATIVE  @map("B-")
  AB_POSITIVE @map("AB+")
  AB_NEGATIVE @map("AB-")
  O_POSITIVE  @map("O+")
  O_NEGATIVE  @map("O-")

  @@schema("core")
}

enum AllergySeverity {
  mild     @map("mild")
  moderate @map("moderate")
  severe   @map("severe")

  @@schema("core")
}

// ─── Student Allergy ─────────────────────────────────────────────────────────

model StudentAllergy {
  id           String          @id @default(uuid()) @db.Uuid
  studentId    String          @map("student_id") @db.Uuid
  name         String          @db.VarChar(100)
  severity     AllergySeverity
  observations String?         @db.VarChar(500)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_allergies")
  @@schema("core")
}

// ─── Student Guardian ─────────────────────────────────────────────────────────

enum StudentGuardianType {
  father         @map("father")
  mother         @map("mother")
  grandmother    @map("grandmother")
  grandfather    @map("grandfather")
  uncle          @map("uncle")
  aunt           @map("aunt")
  brother        @map("brother")
  sister         @map("sister")
  legal_guardian @map("legal-guardian")
  step_father    @map("step-father")
  step_mother    @map("step-mother")
  other          @map("other")

  @@schema("core")
}

model StudentGuardian {
  id                 String              @id @default(uuid()) @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  fullName           String              @map("full_name") @db.VarChar(200)
  relationship       StudentGuardianType
  phoneNumber        String?             @map("phone_number") @db.VarChar(20)
  email              String?             @db.VarChar(150)
  isPrincipal        Boolean             @default(false) @map("is_principal")
  emergencyContact   Boolean             @default(false) @map("emergency_contact")
  authorizedToPickUp Boolean             @default(false) @map("authorized_to_pick_up")
  observations       String?             @db.VarChar(500)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_guardians")
  @@schema("core")
}

// ─── Academic Cycle ──────────────────────────────────────────────────────────

enum AcademicPeriodType {
  annual            @map("annual")
  semester          @map("semester")
  four_month_period @map("four-month-period")
  trimester         @map("trimester")
  bimester          @map("bimester")
  monthly           @map("monthly")
  intensive         @map("intensive")
  special           @map("special")

  @@schema("core")
}

enum AcademicCycleStatus {
  upcoming  @map("upcoming")
  active    @map("active")
  completed @map("completed")
  cancelled @map("cancelled")
  archived  @map("archived")

  @@schema("core")
}

model AcademicCycle {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @db.VarChar(100)
  code                String              @unique @db.VarChar(20)
  startDate           DateTime            @map("start_date")
  endDate             DateTime            @map("end_date")
  periodType          AcademicPeriodType  @map("period_type")
  status              AcademicCycleStatus @default(upcoming)
  minimumPassingGrade Int                 @default(6) @map("minimum_passing_grade")
  evaluationCount     Int                 @default(3) @map("evaluation_count")
  enrollmentOpen      Boolean             @default(false) @map("enrollment_open")
  observations        String?             @db.VarChar(1000)
  academicLevelId     String              @map("academic_level_id") @db.Uuid
  educationLevelId    String              @map("education_level_id") @db.Uuid
  academicLevel       AcademicLevel       @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)
  educationLevel      EducationLevel      @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  schoolSubjects        AcademicCycleSchoolSubject[]
  walletItems           AcademicCycleWallet[]
  groups                AcademicCycleGroup[]
  groupCalendars        AcademicCycleGroupCalendar[]
  enrollments           AcademicCycleEnrollment[]
  studentWalletItems    StudentWalletItem[]
  studentWalletPayments StudentWalletPayment[]

  @@map("academic_cycles")
  @@schema("core")
}

// ─── Academic Cycle School Subject ───────────────────────────────────────────

model AcademicCycleSchoolSubject {
  id              String        @id @default(uuid()) @db.Uuid
  academicCycleId String        @map("academic_cycle_id") @db.Uuid
  schoolSubjectId String        @map("school_subject_id") @db.Uuid
  observations    String?       @db.VarChar(500)
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  schoolSubject   SchoolSubject @relation(fields: [schoolSubjectId], references: [id], onDelete: Restrict)
  calendars       AcademicCycleGroupCalendar[]

  @@unique([academicCycleId, schoolSubjectId])
  @@map("academic_cycle_school_subjects")
  @@schema("core")
}

// ─── Academic Cycle Wallet ───────────────────────────────────────────────────

model AcademicCycleWallet {
  id                 String              @id @default(uuid()) @db.Uuid
  academicCycleId    String              @map("academic_cycle_id") @db.Uuid
  name               String              @db.VarChar(100)
  code               String              @db.VarChar(10)
  description        String?             @db.VarChar(500)
  dueDate            DateTime            @map("due_date")
  amount             Decimal             @db.Decimal(10, 2)
  allowForgiveness   Boolean             @default(false) @map("allow_forgiveness")
  academicCycle      AcademicCycle       @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  studentWalletItems StudentWalletItem[]

  @@unique([academicCycleId, code])
  @@map("academic_cycle_wallet")
  @@schema("core")
}

// ─── Academic Cycle Group ────────────────────────────────────────────────────

enum AcademicCycleSchoolGroupStatus {
  active     @map("active")
  discharged @map("discharged")

  @@schema("core")
}

enum DayOfWeek {
  monday    @map("monday")
  tuesday   @map("tuesday")
  wednesday @map("wednesday")
  thursday  @map("thursday")
  friday    @map("friday")
  saturday  @map("saturday")
  sunday    @map("sunday")

  @@schema("core")
}

model AcademicCycleGroup {
  id                    String                         @id @default(uuid()) @db.Uuid
  name                  String                         @db.VarChar(100)
  status                AcademicCycleSchoolGroupStatus @default(active)
  description           String?                        @db.VarChar(500)
  dischargedDescription String?                        @map("discharged_description") @db.VarChar(500)
  academicCycleId       String                         @map("academic_cycle_id") @db.Uuid
  academicCycle         AcademicCycle                  @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  calendars             AcademicCycleGroupCalendar[]
  enrollments           AcademicCycleEnrollment[]
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  @@map("academic_cycle_groups")
  @@schema("core")
}

// ─── Academic Cycle Group Calendar ───────────────────────────────────────────

model AcademicCycleGroupCalendar {
  id                           String                     @id @default(uuid()) @db.Uuid
  day                          DayOfWeek
  startTime                    DateTime                   @map("start_time") @db.Time
  endTime                      DateTime                   @map("end_time") @db.Time
  academicCycleId              String                     @map("academic_cycle_id") @db.Uuid
  academicCycleSchoolGroupId   String                     @map("academic_cycle_school_group_id") @db.Uuid
  // References the cycle's own subject catalog entry (AcademicCycleSchoolSubject),
  // not the global SchoolSubject catalog directly — a calendar slot can only
  // teach a subject that was actually added to this specific academic cycle.
  academicCycleSchoolSubjectId String                     @map("academic_cycle_school_subject_id") @db.Uuid
  teacherId                    String                     @map("teacher_id") @db.Uuid
  academicCycle                AcademicCycle              @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  academicCycleSchoolGroup     AcademicCycleGroup         @relation(fields: [academicCycleSchoolGroupId], references: [id], onDelete: Cascade)
  academicCycleSchoolSubject   AcademicCycleSchoolSubject @relation(fields: [academicCycleSchoolSubjectId], references: [id], onDelete: Restrict)
  teacher                      Employee                   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@map("academic_cycle_group_calendars")
  @@schema("core")
}

// ─── Academic Cycle Enrollment ────────────────────────────────────────────────

enum AcademicCycleEnrollmentStatus {
  enrolled  @map("enrolled")
  completed @map("completed")
  dropped   @map("dropped")

  @@schema("core")
}

model AcademicCycleEnrollment {
  id                         String                        @id @default(uuid()) @db.Uuid
  code                       String                        @unique @db.VarChar(20)
  status                     AcademicCycleEnrollmentStatus @default(enrolled)
  observations               String?                       @db.VarChar(1000)
  droppedNotes               String?                       @map("dropped_notes") @db.VarChar(1000)
  studentId                  String                        @map("student_id") @db.Uuid
  academicCycleId            String                        @map("academic_cycle_id") @db.Uuid
  academicCycleSchoolGroupId String                        @map("academic_cycle_school_group_id") @db.Uuid
  scholarshipId              String?                       @map("scholarship_id") @db.Uuid
  student                    Student                       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicCycle              AcademicCycle                 @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  academicCycleSchoolGroup   AcademicCycleGroup            @relation(fields: [academicCycleSchoolGroupId], references: [id], onDelete: Restrict)
  scholarship                Scholarship?                  @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                      @default(now()) @map("created_at")
  updatedAt                  DateTime                      @updatedAt @map("updated_at")

  grades      StudentGrade[]
  walletItems StudentWalletItem[]
  payments    StudentWalletPayment[]

  @@map("academic_cycle_enrollments")
  @@schema("core")
}

// ─── Student Grade ────────────────────────────────────────────────────────────

model StudentGrade {
  id                        String                  @id @default(uuid()) @db.Uuid
  grade                     Decimal                 @db.Decimal(4, 2)
  evaluationNumber          Int                     @map("evaluation_number")
  schoolSubjectId           String                  @map("school_subject_id") @db.Uuid
  academicCycleEnrollmentId String                  @map("academic_cycle_enrollment_id") @db.Uuid
  schoolSubject             SchoolSubject           @relation(fields: [schoolSubjectId], references: [id], onDelete: Restrict)
  academicCycleEnrollment   AcademicCycleEnrollment @relation(fields: [academicCycleEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([academicCycleEnrollmentId, schoolSubjectId, evaluationNumber])
  @@map("student_grades")
  @@schema("core")
}

// ─── Student Wallet ───────────────────────────────────────────────────────────

model StudentWalletItem {
  id                        String                  @id @default(uuid()) @db.Uuid
  name                      String                  @db.VarChar(100)
  code                      String                  @db.VarChar(10)
  description               String?                 @db.VarChar(500)
  amount                    Decimal                 @db.Decimal(10, 2)
  allowForgiveness          Boolean                 @default(false) @map("allow_forgiveness")
  outstandingAmount         Decimal                 @map("outstanding_amount") @db.Decimal(10, 2)
  isForgiven                Boolean                 @default(false) @map("is_forgiven")
  extensionDate             DateTime?               @map("extension_date")
  dueDate                   DateTime                @map("due_date")
  studentId                 String                  @map("student_id") @db.Uuid
  academicCycleId           String                  @map("academic_cycle_id") @db.Uuid
  academicCycleEnrollmentId String                  @map("academic_cycle_enrollment_id") @db.Uuid
  academicCycleWalletId     String                  @map("academic_cycle_wallet_id") @db.Uuid
  student                   Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicCycle             AcademicCycle           @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  academicCycleEnrollment   AcademicCycleEnrollment @relation(fields: [academicCycleEnrollmentId], references: [id], onDelete: Cascade)
  academicCycleWallet       AcademicCycleWallet     @relation(fields: [academicCycleWalletId], references: [id], onDelete: Restrict)
  payments                  StudentWalletPayment[]

  @@map("student_wallet_items")
  @@schema("core")
}

enum PaymentMethod {
  online_payment @map("online-payment")
  cash           @map("cash")
  // System-generated only (StudentWalletService.updateItem, when an item's
  // isForgiven transitions to true) — never selectable via the create-payment
  // endpoint. Gives forgiveness a real entry in the payment history instead
  // of just zeroing outstandingAmount silently.
  forgiven       @map("forgiven")

  @@schema("core")
}

model StudentWalletPayment {
  id                        String                  @id @default(uuid()) @db.Uuid
  folio                     String                  @unique @db.VarChar(20)
  amount                    Decimal                 @db.Decimal(10, 2)
  paymentMethod             PaymentMethod           @map("payment_method")
  academicCycleId           String                  @map("academic_cycle_id") @db.Uuid
  academicCycleEnrollmentId String                  @map("academic_cycle_enrollment_id") @db.Uuid
  studentWalletItemId       String                  @map("student_wallet_item_id") @db.Uuid
  academicCycle             AcademicCycle           @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  academicCycleEnrollment   AcademicCycleEnrollment @relation(fields: [academicCycleEnrollmentId], references: [id], onDelete: Cascade)
  studentWalletItem         StudentWalletItem       @relation(fields: [studentWalletItemId], references: [id], onDelete: Restrict)
  createdAt                 DateTime                @default(now()) @map("created_at")

  @@map("student_wallet_payments")
  @@schema("core")
}
