# Server
PORT=3000

# Database - Update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/colegio_lear?schema=public"

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_DIR="./logs"
LOG_RETENTION_DAYS=30
LOG_LEVEL="info"

# Super Admin Seed
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeMe123"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""

# Mail
MAIL_PROVIDER="gmail"
MAIL_FROM="noreply@colegiolear.com"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""

# Cookie
COOKIE_SECURE=false

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN="http://localhost:5173,http://localhost"

# Admin 1 Seed
ADMIN1_NAME="Admin"
ADMIN1_LAST_NAME="One"
ADMIN1_EMAIL="admin1@colegiolear.com"
ADMIN1_PASSWORD="Admin123!"

# Admin 2 Seed
ADMIN2_NAME="Admin"
ADMIN2_LAST_NAME="Two"
ADMIN2_EMAIL="admin2@colegiolear.com"
ADMIN2_PASSWORD="Admin456!"

# Frontend hosts para correos de EMAIL (según el destinatario: admin/profesor o alumno)
FRONTEND_URL_ADMIN="http://localhost:5173"
FRONTEND_URL_STUDENT="http://localhost:5173"

# Backend (origen público, usado para armar URLs absolutas de archivos locales en /uploads).
# Opcional: en local cae a http://localhost:PORT y en Azure App Service se
# autodetecta desde WEBSITE_HOSTNAME (dominio real del Web App) — solo
# defínelo aquí si necesitas forzar un valor distinto (ej. dominio propio).
# BACKEND_URL="http://localhost:3000"
