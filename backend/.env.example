# Server
PORT=3000

# Database - Update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/colegio_lear?schema=public"

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_DIR="./logs"
LOG_RETENTION_DAYS=30
LOG_LEVEL="info"

# Super Admin Prisma Seed
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeMe123"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"

# Storage
# Supabase Storage. URL del proyecto sin /rest/v1; la clave es la Secret key
# (sb_secret_...) o la service_role legacy — nunca la publishable/anon.
# El bucket debe ser público.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Mail
# "gmail" (SMTP, desarrollo local) o "graph" (Microsoft Graph por HTTPS; usar en
# Render, que bloquea los puertos SMTP). Con "graph", MAIL_FROM es el buzón de
# Microsoft 365 que envía y MAIL_HOST/PORT/USER/PASSWORD no se usan.
MAIL_PROVIDER="gmail"
MAIL_FROM="noreply@colegiolear.com"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_GRAPH_TENANT_ID=""
MAIL_GRAPH_CLIENT_ID=""
MAIL_GRAPH_CLIENT_SECRET=""

# Cookie
COOKIE_SECURE=false

# CORS
CORS_ORIGIN="http://localhost,http://localhost"

# Admin 1 Prisma Seed
ADMIN1_NAME="Admin"
ADMIN1_LAST_NAME="One"
ADMIN1_EMAIL="admin1@colegiolear.com"
ADMIN1_PASSWORD="Admin123!"

# Admin 2 Prisma Seed
ADMIN2_NAME="Admin"
ADMIN2_LAST_NAME="Two"
ADMIN2_EMAIL="admin2@colegiolear.com"
ADMIN2_PASSWORD="Admin456!"

# Frontend hosts para correos de EMAIL (según el destinatario: admin/profesor o alumno)
FRONTEND_URL_ADMIN="http://localhost:5173"
FRONTEND_URL_STUDENT="http://localhost:5173"

# Frontend host para correos de EMAIL
FRONTEND_URL_ADMIN="http://localhost"
FRONTEND_URL_STUDENT="http://localhost"
